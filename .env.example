# Copy to .env. NEVER commit .env.
# Public identity of this deployment
PLATFORM_HOST=platform.example.com
WINDMILL_HOST=wm.example.com
BOOKING_HOST=booking.example.com
PUBLIC_PLATFORM_URL=https://platform.example.com
PUBLIC_WINDMILL_BASE_URL=https://wm.example.com
PUBLIC_BOOKING_URL=https://booking.example.com

# Supabase (managed project owned by SAFI)
# SUPABASE_URL is what the trusted API calls. PUBLIC_SUPABASE_URL is what the
# browser calls. They are identical on managed Supabase. For the AWS-only
# self-hosted stack, SUPABASE_URL is the internal gateway and
# PUBLIC_SUPABASE_URL is https://supabase.<domain>.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:password@db.YOUR-PROJECT.supabase.co:5432/postgres

# Acceptance test users (used by scripts/seed-supabase.mjs and tests)
E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=
E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=
E2E_BOOKING_NAME=SAFI Acceptance User
E2E_BOOKING_EMAIL=

# Windmill (server + worker + its own Postgres)
WINDMILL_WORKSPACE=safi
WINDMILL_FLOW_PATH=f/safi/safi_assistant
WINDMILL_CHAT_TOKEN=
WINDMILL_POSTGRES_PASSWORD=change-me-long-random
WINDMILL_ADMIN_EMAIL=admin@example.com
WINDMILL_ADMIN_PASSWORD=change-me-long-random
WINDMILL_INTERNAL_BASE_URL=http://windmill_server:8000

# Trusted API
SAFI_API_PORT=8080
SAFI_CONTEXT_SECRET=change-me-32-bytes-minimum
SAFI_INTERNAL_TOKEN=change-me-internal-shared-secret
SAFI_CONTEXT_TTL_SECONDS=14400
SAFI_ARTIFACT_TEMPLATE_REF=checklist.v1

# Calnode (single container, persistent SQLite)
CALNODE_BASE_URL=http://calnode:3000
CALNODE_PUBLIC_URL=https://booking.example.com
CALNODE_API_KEY=
CALNODE_EVENT_SLUG=follow-up-30
CALNODE_TIMEZONE=UTC
CALNODE_ENCRYPTION_KEY=
CALNODE_RECOVERY_SECRET=

# Conflicting-slot fixture (scripts/create-conflicting-fixture.mjs)
FIXTURE_CONTACT_NAME=SAFI Conflict Fixture
FIXTURE_CONTACT_EMAIL=safi-fixture@example.com
FIXTURE_DAYS=14

# Optional: Caddy uses 80/443
CADDY_EMAIL=ops@example.com

# Release label, never "latest"
SAFI_RELEASE=0.1.0
