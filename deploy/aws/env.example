# Append these values to the repo-root .env for the AWS-only overlay.
# Copy the generated secrets from `node deploy/aws/gen-supabase-keys.mjs`.

SUPABASE_HOST=supabase.example.com

# Generated secrets (do not commit the real values).
POSTGRES_PASSWORD=
AUTHENTICATOR_PASSWORD=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LITELLM_MASTER_KEY=

# The trusted API talks to Caddy's internal gateway; the browser talks to the
# public Supabase host. Keep both values in sync with SUPABASE_HOST.
SUPABASE_URL=http://supabase_gateway:8000
PUBLIC_SUPABASE_URL=https://supabase.example.com

# LiteLLM maps the OpenAI-compatible model name "gpt-4o-mini" to this model.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
